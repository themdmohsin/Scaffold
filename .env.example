# Repo-root .env - read by `docker compose` for BUILD ARGS of the dashboard image
# (Vite inlines VITE_* at build time; engine/.env is NOT visible to the build and
# dashboard/.env is excluded from the Docker context). Copy and fill:
#   cp .env.example .env     (or: copy dashboard/.env .env)
# After changing any value: docker compose up -d --build dashboard
#
# URL the BROWSER uses to reach the engine (not a docker-internal hostname).
# REQUIRED for production builds (the dashboard fails to boot without it; dev-only default below).
VITE_ENGINE_URL=http://localhost:8000
# Supabase project URL (bare https://<ref>.supabase.co) + the PUBLIC anon key.
# Without these the dashboard cannot sign in (it shows a configuration error).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
