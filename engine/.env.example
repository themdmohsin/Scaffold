# engine/.env — exact names frozen in docs/API_CONTRACTS.md (never commit real values)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SCAFFOLD_TEAM_LLM_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
DATABASE_URL=
SCAFFOLD_DEFAULT_PROJECT_ID=
# Optional Day 3 overrides — defaults: gemini/gemini-2.5-flash + gemini/gemini-embedding-001
SCAFFOLD_LLM_MODEL=
SCAFFOLD_EMBED_MODEL=
# Optional Day 4 Part B — owner/repo for auto-filed conflict issues (default: themdmohsin/Scaffold)
SCAFFOLD_GITHUB_REPO=
# Optional Phase 5 — name of the scaffold_secrets.keyring row used to wrap secret
# values. Unset: the newest keyring row is used (the migration bootstraps one named
# 'default' with a server-generated random key). Set ONLY to pin a specific key.
SCAFFOLD_SECRET_KEYRING=
# Phase 6 (real authentication). Supabase Auth JWTs (ES256/RS256) are verified against the
# JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json - selected by kid, cached, rotation-safe -
# so SUPABASE_URL (above) is all an asymmetric-key project needs. SUPABASE_JWT_SECRET is ONLY
# for LEGACY HS256 projects (Settings > API > JWT Secret); leave it empty otherwise. Never a
# private key, never an sb_secret_ key. With neither set, authenticated routes 503 (fail closed).
SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed by CORS (e.g. http://localhost:5173).
# Empty = wildcard (DEV ONLY). Set explicitly in any shared deployment.
SCAFFOLD_CORS_ORIGINS=
# DEV/SEED ONLY — comma-separated Supabase user ids auto-promoted to OWNER on
# any project they touch (bootstrap for pre-auth projects). Leave EMPTY in prod.
SCAFFOLD_BOOTSTRAP_ACCOUNT_IDS=

# ---------------------------------------------------------------------------
# Day 9 — deployment hardening (see docs/DEPLOYMENT.md + docs/OPERATIONS.md)
# ---------------------------------------------------------------------------
# "development" (default) or "production". Production makes startup config
# validation FATAL: missing DATABASE_URL / SUPABASE_JWT_SECRET / CORS origins or
# a set SCAFFOLD_BOOTSTRAP_ACCOUNT_IDS stop the engine from booting with an
# actionable message instead of failing at first request.
SCAFFOLD_ENV=development
# Structured logs: json (default; one JSON object per line) or text.
SCAFFOLD_LOG_FORMAT=json
SCAFFOLD_LOG_LEVEL=INFO
# Basic in-process rate limiting (sliding 60s window per IP + credential) on
# auth routes, POST /reason, and environment value endpoints. Set to 0 to
# disable (e.g. load tests); tune per-minute budgets as needed.
SCAFFOLD_RATE_LIMIT_ENABLED=1
SCAFFOLD_RATE_LIMIT_AUTH_PER_MINUTE=120
SCAFFOLD_RATE_LIMIT_REASON_PER_MINUTE=30
SCAFFOLD_RATE_LIMIT_SECRET_PER_MINUTE=240
# Trust X-Forwarded-For's first hop for client IPs. Enable ONLY behind a proxy
# you control (Fly.io / Railway edge), never when the engine is directly exposed.
SCAFFOLD_TRUST_PROXY=0
